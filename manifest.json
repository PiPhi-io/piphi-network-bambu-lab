{
  "$schema": "./schema/piphi-manifest.schema.json",
  "manifest_version": "1.0",
  "id": "piphi-network-bambu-lab",
  "name": "Bambu Lab",
  "version": "0.1.0",
  "description": "Read-only monitoring of Bambu printers through explicitly enabled LAN Developer Mode.",
  "metadata": {
    "generator": "piphi-network-create",
    "scaffold_version": "0.3.0",
    "preset": "actuator-device",
    "domain": "local-device",
    "preset_summary": "Local actuator starter with command and safety-oriented controls."
  },
  "maintainer": {
    "name": "PiPhi Network",
    "website": "https://piphi.io"
  },
  "license": "Apache-2.0",
  "image": "docker.io/piphinetwork/piphi-network-bambu-lab:0.1.0",
  "platforms": [
    "linux"
  ],
  "runtime": {
    "linux": {
      "type": "container",
      "container": {
        "image": "docker.io/piphinetwork/piphi-network-bambu-lab:0.1.0",
        "ports": [
          {
            "container": 4203,
            "host": 4203
          }
        ],
        "environment": {
          "LOG_LEVEL": "info"
        },
        "restart_policy": {
          "name": "unless-stopped",
          "maximum_retry_count": 0
        }
      },
      "discovery": {
        "method": "manual"
      }
    }
  },
  "api": {
    "required": [
      "health",
      "entities",
      "command",
      "config",
      "ui_config"
    ],
    "endpoints": {
      "health": "/health",
      "diagnostics": "/diagnostics",
      "discover": "/discover",
      "entities": "/entities",
      "state": "/state",
      "config": "/config",
      "config_sync": "/config/sync",
      "deconfigure": "/deconfigure",
      "ui_config": "/ui-config",
      "events": "/events",
      "command": "/command"
    }
  },
  "config": {
    "source": "endpoint",
    "endpoint": "/ui-config",
    "required": true,
    "editable_fields": [
      "simulation_mode",
      "host",
      "alias",
      "serial",
      "access_code",
      "developer_mode_acknowledged"
    ],
    "runtime_fields": [
      "id",
      "config_id",
      "container_id",
      "device_id"
    ],
    "identity_fields": [
      "host",
      "serial"
    ]
  },
  "identity": {
    "fields": [
      "host",
      "serial"
    ]
  },
  "capabilities": {
    "connected": {
      "kind": "sensor",
      "unit": "bool"
    },
    "simulation_mode": {
      "kind": "sensor",
      "unit": "bool"
    },
    "print_status": {
      "kind": "sensor"
    },
    "print_progress_percent": {
      "kind": "sensor",
      "unit": "%"
    },
    "remaining_time_minutes": {
      "kind": "sensor",
      "unit": "min"
    },
    "current_layer": {
      "kind": "sensor"
    },
    "total_layers": {
      "kind": "sensor"
    },
    "nozzle_temperature_c": {
      "kind": "sensor",
      "unit": "C"
    },
    "target_nozzle_temperature_c": {
      "kind": "sensor",
      "unit": "C"
    },
    "bed_temperature_c": {
      "kind": "sensor",
      "unit": "C"
    },
    "target_bed_temperature_c": {
      "kind": "sensor",
      "unit": "C"
    },
    "refresh": {
      "kind": "action"
    }
  },
  "commands": {
    "refresh": {
      "description": "Request a full printer status at most once every five minutes.",
      "timeout_ms": 5000
    }
  },
  "entities": [
    {
      "id": "bambu-printer",
      "name": "Bambu printer",
      "device_id": "bambu-printer",
      "entity_type": "sensor",
      "capabilities": [
        "connected",
        "simulation_mode",
        "print_status",
        "print_progress_percent",
        "remaining_time_minutes",
        "current_layer",
        "total_layers",
        "nozzle_temperature_c",
        "target_nozzle_temperature_c",
        "bed_temperature_c",
        "target_bed_temperature_c",
        "refresh"
      ],
      "available_commands": [
        {
          "id": "refresh",
          "label": "Refresh",
          "kind": "action"
        }
      ],
      "dashboard": {
        "allowed_widgets": [
          "tile",
          "stat",
          "external-widget"
        ],
        "default_widget": "external-widget"
      }
    }
  ],
  "marketplace": {
    "metadata_version": 2,
    "display_name": "Bambu Lab",
    "summary": "Read-only monitoring of Bambu printers through explicitly enabled LAN Developer Mode.",
    "category": "appliances",
    "regions": [
      "WW"
    ],
    "languages": [
      "en"
    ],
    "publisher": {
      "name": "PiPhi Network",
      "website_url": "https://piphi.io",
      "support_url": "https://github.com/PiPhi-io/piphi-network-bambu-lab/issues",
      "security_contact": "support@piphi.io"
    },
    "access": [
      {
        "id": "local_network",
        "label": "Local network access",
        "reason": "Discovers or communicates with supported services and devices on the homeowner's local network.",
        "required": true
      },
      {
        "id": "credentials",
        "label": "Account or device credentials",
        "reason": "Authenticates only to the configured vendor account, service, or local device and keeps credentials out of state and diagnostics.",
        "required": true
      }
    ],
    "compatibility": [
      {
        "brand": "Bambu Lab",
        "model": "Supported A, P, and X series printers in LAN mode"
      }
    ],
    "documentation_url": "https://github.com/PiPhi-io/piphi-network-bambu-lab",
    "support_url": "https://github.com/PiPhi-io/piphi-network-bambu-lab/issues",
    "changelog_url": "https://github.com/PiPhi-io/piphi-network-bambu-lab/releases",
    "quality_tier": "unrated",
    "governance": {
      "schema_version": 1,
      "publication_status": "draft",
      "rollout_percent": 0,
      "lifecycle_status": "active",
      "qualification": {
        "status": "unverified"
      }
    },
    "device_types": [
      "3D printer"
    ],
    "protocols": [
      "MQTT",
      "LAN mode"
    ],
    "discovery_methods": [
      "manual"
    ],
    "connectivity": "local",
    "offline_support": "none"
  },
  "ui": {
    "widget_packages": [
      {
        "id": "io.piphi.bambu.print-status",
        "name": "Bambu print status",
        "version": "0.1.0",
        "entry": "/widgets/print-status/dist/widget.js",
        "runtime": "prebuilt_bundle",
        "certification": {
          "verified_gates": ["runtime", "persistence", "binding", "states", "responsive", "themes", "accessibility", "save-reload", "performance"],
          "evidence": {
            "runtime": ["core-profile:sandbox-host-v1/runtime"],
            "persistence": ["core-profile:sandbox-host-v1/persistence"],
            "binding": ["widgets/print-status/test/widget.test.mjs"],
            "states": ["widgets/print-status/test/widget.test.mjs"],
            "responsive": ["widgets/print-status/test/widget.test.mjs"],
            "themes": ["widgets/print-status/test/widget.test.mjs"],
            "accessibility": ["widgets/print-status/test/widget.test.mjs"],
            "save-reload": ["core-profile:sandbox-host-v1/save-reload"],
            "performance": ["core-profile:sandbox-host-v1/performance"]
          }
        },
        "host_bridge": {
          "protocol": "piphi.widget.host",
          "version": "1",
          "events": [
            "ready",
            "resize"
          ]
        },
        "binding_modes": [
          "read"
        ],
        "value_kinds": [
          "numeric",
          "boolean",
          "text"
        ],
        "capability_requirements": [
          "connected",
          "simulation_mode",
          "print_status",
          "print_progress_percent",
          "remaining_time_minutes",
          "current_layer",
          "total_layers",
          "nozzle_temperature_c",
          "bed_temperature_c"
        ],
        "sdk_compatibility": {
          "minimum": "0.5.1"
        },
        "settings_schema_version": "1",
        "settings": [
          {
            "id": "title",
            "type": "text",
            "label": "Title",
            "default": "Bambu printer"
          },
          {
            "id": "device",
            "type": "device",
            "label": "Bambu printer",
            "required": true
          }
        ],
        "layout": {
          "min_height": 154,
          "default_height": 200,
          "max_height": 320
        },
        "security": {
          "permissions": [],
          "sandbox": [
            "allow-scripts"
          ],
          "csp": {
            "connect_src": []
          }
        }
      }
    ]
  }
}
